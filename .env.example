# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose. Used by scripts/activate-plan.mjs.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (Google Gemini). Optional: insights page shows deterministic numbers without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Payments (Selar checkout links)
NEXT_PUBLIC_PAYMENT_LINK_GROWTH=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_SCALE=https://selar.com/57plan?currency=USD
