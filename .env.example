# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose. Used by the payment webhook to activate plans.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (Google Gemini). Optional: insights page shows deterministic numbers without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Payments (Stripe Payment Links). Provide your own links.
NEXT_PUBLIC_PAYMENT_LINK_GROWTH=
STRIPE_WEBHOOK_SECRET=
# Stripe payment link IDs (plink_...) so the webhook can map a payment to a plan
STRIPE_PAYMENT_LINK_ID_GROWTH=
CONTACT_EMAIL=
